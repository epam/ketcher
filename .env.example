# Copy this file to .env at the repo root to configure package builds
# without exporting environment variables by hand before every invocation.
# Loaded by packages/ketcher-react/rollup.config.mjs and
# packages/ketcher-macromolecules/rollup.config.mjs. A variable already set
# in the shell always takes precedence over the value in this file.

# Set to "true" to build every supported language (English + Simplified
# Chinese) into ketcher-react/ketcher-macromolecules, including the Settings
# language switcher. Unset (or anything other than "true") builds the
# default English-only bundle. See packages/ketcher-react/src/locales/README.md
# for the full mechanism.
KETCHER_MULTI_LANGUAGE_BUILD=false
