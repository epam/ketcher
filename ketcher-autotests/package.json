{
  "name": "playwright-testing",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "report": "npx playwright show-report playwright-report/html",
    "test": "npx playwright test",
    "test:debug": "npx playwright test --debug",
    "test:update": "npx playwright test --update-snapshots=changed",
    "test:trace": "npx playwright test --trace on",
    "check:code": "npm run check:types && npm run check:lint",
    "check:types": "tsc --noEmit",
    "test:types": "tsc --noEmit",
    "check:lint": "oxlint -c ../.oxlintrc.json . && oxfmt --check \"./**/*.{js,ts}\"",
    "lint:fix": "oxlint -c ../.oxlintrc.json . --fix",
    "oxfmt:write": "oxfmt \"./**/*.{js,ts}\" ",
    "docker:build": "docker-compose build autotests && docker-compose run --rm autotests bash /app/test_prepare.sh",
    "docker:test": "docker-compose run --rm autotests bash /app/test_run.sh --project=chromium",
    "docker:test-popup": "docker-compose run --rm autotests bash /app/test_run.sh --project=chromium-popup",
    "docker:trace": "docker-compose run --rm autotests bash /app/test_run.sh --project=chromium --trace on",
    "docker:trace-popup": "docker-compose run --rm autotests bash /app/test_run.sh --project=chromium-popup --trace on",
    "docker:update": "docker-compose run --rm -e GENERATE_DATA=true autotests bash /app/test_run.sh --update-snapshots=changed",
    "docker:update-popup": "docker-compose run --rm -e GENERATE_DATA=true autotests bash /app/test_run.sh --project=chromium-popup --update-snapshots=changed"
  },
  "author": "Nitvex",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "cross-env": "^7.0.3",
    "glob": "^14.0.2",
    "lint-staged": "^16.4.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "ketcher-core": "*"
  },
  "lint-staged": {
    "*.md": [
      "oxfmt"
    ],
    "*.{js,ts}": [
      "oxfmt",
      "oxlint -c ../.oxlintrc.json ."
    ]
  },
  "types": "./tests/typings.d.ts"
}
