{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "components/*": ["./src/components/*"],
      "state/*": ["./src/state/*"],
      "state": ["./src/state"],
      "hooks": ["./src/hooks"],
      "assets/*": ["./src/assets/*"],
      "theming/*": ["./src/theming/*"],
      "helpers": ["./src/helpers"],
      "helpers/*": ["./src/helpers/*"],
      "src/*": ["./src/*"]
    }
  },
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "dist/**/*"]
}
