{
  "name": "ketcher",
  "private": true,
  "workspaces": [
    "packages/ketcher-core",
    "packages/ketcher-standalone",
    "packages/ketcher-macromolecules",
    "packages/ketcher-react",
    "ketcher-autotests",
    "example",
    "example-ssr",
    "example-separate-editors",
    "demo"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run build:packages && npm run build:example",
    "build:example:standalone": "npm run build:standalone -w example",
    "build:example:remote": "npm run build:remote -w example",
    "build:core": "npm run build -w ketcher-core",
    "build:standalone": "npm run build -w ketcher-standalone",
    "build:react": "npm run build -w ketcher-react",
    "build:macromolecules": "npm run build -w ketcher-macromolecules",
    "build:packages": "npm run build:core && run-p build:standalone build:macromolecules && npm run build:react",
    "build:example": "npm run build -w example",
    "build:demo": "npm run build:packages && npm run build -w demo",
    "test": "npm run test --workspace=packages/ketcher-core --workspace=packages/ketcher-react --workspace=packages/ketcher-standalone --workspace=packages/ketcher-macromolecules && npm run test:build-config",
    "test:build-config": "node --test demo/vite.config.test.mjs example/vite.config.test.mjs",
    "test:types": "npm run test:types --workspaces",
    "check:autotests": "cd ketcher-autotests && npm run check:code",
    "check:package-metadata": "node scripts/check-package-metadata.mjs",
    "lint": "oxlint packages scripts",
    "serve:remote": "cd example && npm run serve:remote",
    "serve:standalone": "cd example && npm run serve:standalone",
    "serve": "run-p serve:remote serve:standalone",
    "serve:demo": "cd demo && npm run serve",
    "up": "node ./scripts/build-run.mjs",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "generate:agent-instructions": "node scripts/generate-agent-instructions.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fission-ai/openspec": "2.1.1",
    "color-alpha": "^1.1.3",
    "danger": "14.1.0",
    "dotenv": "^10.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "eslint-plugin-testing-library": "^7.0.0",
    "glob": "^14.0.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "1.91.0",
    "postcss": "^8.5.23",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "prettier-config-standard": "^5.0.0",
    "publint": "^0.3.24",
    "shx": "^0.4.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-less": "^3.0.1",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "react-error-overlay": "6.0.9"
  },
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=24.20.0",
    "yarn": "YARN IS NO LONGER USED, PLEASE USE NPM\nConversion instructions can be found in DEVNOTES.md"
  },
  "overrides": {
    "nth-check": "^2.1.1"
  },
  "dependencies": {
    "@playwright/test": "^1.65.0",
    "intl-messageformat": "^10.7.18",
    "minimatch": "^11.0.1",
    "playwright": "^1.65.0",
    "playwright-core": "^1.65.0",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.2",
    "serve-handler": "^6.1.7"
  }
}
