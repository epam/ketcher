{
  "name": "ketcher-standalone",
  "version": "3.23.0-dev.2",
  "description": "Web-based molecule sketcher",
  "license": "Apache-2.0",
  "homepage": "https://lifescience.opensource.epam.com/ketcher/",
  "author": {
    "name": "EPAM Life Sciences",
    "url": "https://lifescience.opensource.epam.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/epam/ketcher.git",
    "directory": "packages/ketcher-standalone"
  },
  "keywords": [
    "molecule",
    "sketcher",
    "chemistry"
  ],
  "bugs": {
    "url": "https://github.com/epam/ketcher/issues"
  },
  "main": "dist/cjs/main.js",
  "module": "dist/main.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "start": "run-p --print-label start:vite start:typecheck",
    "start:vite": "cross-env NODE_ENV=development vite build --watch",
    "start:typecheck": "tsc --watch --noEmit",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:related": "vitest related --passWithNoTests",
    "test": "run-s test:oxfmt test:oxlint:quiet test:types test:unit",
    "test:oxlint": "oxlint -c ../../.oxlintrc.json .",
    "test:oxlint:quiet": "npm run test:oxlint -- --quiet",
    "test:oxlint:fix": "npm run test:oxlint -- --fix",
    "test:oxfmt": "oxfmt --check \"./**/*.{js,ts,json}\"",
    "oxfmt:write": "oxfmt \"./**/*.{js,ts,json}\""
  },
  "dependencies": {
    "events": "^3.3.0",
    "indigo-ketcher": "1.50.0-rc.2",
    "ketcher-core": "*",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@rollup/plugin-strip": "^2.0.0",
    "@types/node": "^16.11.12",
    "cross-env": "^7.0.3",
    "npm-run-all2": "^9.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/main.js",
      "require": "./dist/cjs/main.js"
    },
    "./dist/binaryWasm": {
      "types": "./dist/binaryWasm/index.d.ts",
      "import": "./dist/binaryWasm/main.js"
    },
    "./dist/jsNoRender": {
      "types": "./dist/jsNoRender/index.d.ts",
      "import": "./dist/jsNoRender/main.js",
      "require": "./dist/cjs/jsNoRender/main.js"
    },
    "./dist/binaryWasmNoRender": {
      "types": "./dist/binaryWasmNoRender/index.d.ts",
      "import": "./dist/binaryWasmNoRender/main.js"
    },
    "./package.json": "./package.json"
  }
}
